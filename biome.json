{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["src/**", "test/**", "e2e/**", "tools/**", "*.ts", "*.json", "!hutch.lock"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineWidth": 160
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all",
			"arrowParentheses": "always"
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "off"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"noNonNullAssertion": "off",
				"useImportType": "error",
				"useConst": "error"
			},
			"complexity": {
				"noCommaOperator": "off",
				"noBannedTypes": "error",
				"useOptionalChain": "error",
				"noUselessLoneBlockStatements": "error"
			},
			"correctness": {
				"noVoidTypeReturn": "off",
				"noUnusedImports": "error",
				"noUnusedVariables": "error",
				"noUnusedFunctionParameters": "error"
			},
			"suspicious": {
				"noAssignInExpressions": "off",
				"useIterableCallbackReturn": "off",
				"noShadowRestrictedNames": "error"
			},
			"performance": {
				"useDomNodeTextContent": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": ["src/watcher/**", "src/shared/**", "src/scene/director/**", "src/scene/director.ts", "src/scene/sass/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"pixi.js": "This layer is Pixi-free: it is pure data and logic, tested without a browser. See AGENTS.md, Architecture."
								}
							}
						}
					}
				}
			}
		}
	]
}
